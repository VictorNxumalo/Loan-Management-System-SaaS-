# =============================================================================
# LMS — Sandbox (hosted pre-production)
# Copy into Vercel (sandbox project) + Render (sandbox API) dashboards.
# Use fake data, Stripe test keys, SKIP_EMAIL verification.
# NEVER reuse production secrets or production Supabase project URLs here.
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=sandbox

# ─── Supabase — dedicated SANDBOX project (not production) ───────────────────
DATABASE_URL=postgresql://postgres.[SANDBOX-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[SANDBOX-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[SANDBOX-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lms-documents

# ─── Redis (sandbox instance) ────────────────────────────────────────────────
REDIS_URL=

# ─── JWT — unique to sandbox (different from production) ─────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Email (optional on sandbox) ───────────────────────────────────────────────
SKIP_EMAIL_VERIFICATION=true

# ─── Stripe — test mode only ───────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Sandbox web URL (Vercel project tied to `staging` branch) ───────────────
NEXTAUTH_URL=https://your-sandbox-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-sandbox-api.onrender.com/v1
API_URL=https://your-sandbox-api.onrender.com/v1
NEXTAUTH_SECRET=

# Render sandbox API — allow sandbox + preview Vercel origins
STAGING_ALLOW_VERCEL_CORS=true

# ─── Legal (can differ from production while testing copy) ─────────────────────
# NEXT_PUBLIC_LEGAL_OPERATOR_NAME=LMS Sandbox
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=sandbox@yourdomain.com

TRIAL_DAYS=14
CRON_OVERDUE_ENABLED=true
CRON_REMINDER_ENABLED=true

# ─── Monitoring (Sentry) — optional; use sandbox environment tag ─────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=sandbox
# SENTRY_TRACES_SAMPLE_RATE=0.1
