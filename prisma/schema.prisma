// LMS — Loan Management System
// Multi-tenant schema with org_id on all tenant-scoped tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  LOAN_OFFICER
  VIEWER
}

enum AccountType {
  LENDER
  BORROWER
}

enum BorrowerLinkSource {
  INVITE
  PUBLIC
}

enum OrganisationPlan {
  STARTER
  PRO
  BUSINESS
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  READ_ONLY
}

enum InterestType {
  FLAT
  REDUCING
}

enum LoanStatus {
  DRAFT
  ACTIVE
  IN_ARREARS
  COMPLETED
  WRITTEN_OFF
}

enum RepaymentFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum DocumentEntityType {
  BORROWER
  LOAN
  LOAN_APPLICATION
  PAYMENT_SUBMISSION
}

enum PaymentProvider {
  MANUAL
  STRIPE
  STITCH
}

enum StitchDisbursementStatus {
  PENDING
  SUBMITTED
  COMPLETED
  ERROR
  PAUSED
  CANCELLED
  REVERSED
}

enum PaymentSubmissionStatus {
  AWAITING_PROOF
  PENDING
  CONFIRMED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum WalletOwnerType {
  ORGANISATION
  BORROWER_USER
}

enum WalletTransactionType {
  TOP_UP
  WITHDRAWAL
  DISBURSEMENT
  REPAYMENT
  ADJUSTMENT
  REVERSAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisbursementStatus {
  NOT_STARTED
  PENDING
  COMPLETED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Organisation {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  plan               OrganisationPlan @default(STARTER)
  planStatus         PlanStatus       @default(TRIAL) @map("plan_status")
  trialEndsAt        DateTime?        @map("trial_ends_at")
  settings           Json             @default("{}")
  stripeCustomerId   String?          @unique @map("stripe_customer_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  users         User[]
  borrowers     Borrower[]
  loans         Loan[]
  repayments    Repayment[]
  documents     Document[]
  auditLogs     AuditLog[]
  notifications Notification[]
  subscriptions Subscription[]
  lenderInvites     LenderInvite[]
  borrowerLinks     BorrowerLenderLink[]
  loanApplications  LoanApplication[]
  paymentSubmissions PaymentSubmission[]
  teamInvites       TeamInvite[]
  wallet            Wallet?
  loanStitchDisbursements LoanStitchDisbursement[]
  stitchLinkPay     OrganisationStitchLinkPay?

  @@map("organisations")
}

model User {
  id                    String      @id @default(uuid()) @db.Uuid
  accountType           AccountType @default(LENDER) @map("account_type")
  orgId                 String?     @map("org_id") @db.Uuid
  email                 String      @unique
  name                  String
  role                  UserRole?   @default(LOAN_OFFICER)
  idNumber              String?     @map("id_number")
  address               String?
  passwordHash          String?     @map("password_hash")
  googleId              String?     @unique @map("google_id")
  emailVerifiedAt       DateTime?   @map("email_verified_at")
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  organisation            Organisation?            @relation(fields: [orgId], references: [id])
  borrowerAccount         BorrowerAccount?
  borrowerLinks           BorrowerLenderLink[]
  loanApplications        LoanApplication[]       @relation("LoanApplicationBorrower")
  loanApplicationsReviewed LoanApplication[]        @relation("LoanApplicationReviewer")
  loansCreated            Loan[]                   @relation("LoanCreatedBy")
  repaymentsRecorded      Repayment[]              @relation("RepaymentRecordedBy")
  documentsUploaded       Document[]               @relation("DocumentUploadedBy")
  auditLogs               AuditLog[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  teamInvitesSent         TeamInvite[]             @relation("TeamInviteInvitedBy")
  paymentSubmissionsSubmitted PaymentSubmission[]  @relation("PaymentSubmissionSubmittedBy")
  paymentSubmissionsReviewed  PaymentSubmission[]  @relation("PaymentSubmissionReviewedBy")
  wallet                      Wallet?
  kycDocuments                UserKycDocument[]

  @@index([orgId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model BorrowerAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  phone     String
  idNumber  String?  @map("id_number")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("borrower_accounts")
}

model BorrowerLenderLink {
  id             String            @id @default(uuid()) @db.Uuid
  borrowerUserId String            @map("borrower_user_id") @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  source         BorrowerLinkSource @default(INVITE)
  createdAt      DateTime          @default(now()) @map("created_at")

  borrowerUser User         @relation(fields: [borrowerUserId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([borrowerUserId, orgId])
  @@index([borrowerUserId])
  @@index([orgId])
  @@map("borrower_lender_links")
}

model LenderInvite {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@map("lender_invites")
}

model TeamInvite {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  email           String
  role            UserRole
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("TeamInviteInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([orgId, email])
  @@map("team_invites")
}

model LoanApplication {
  id               String                @id @default(uuid()) @db.Uuid
  orgId            String                @map("org_id") @db.Uuid
  borrowerUserId   String                @map("borrower_user_id") @db.Uuid
  borrowerId       String?               @map("borrower_id") @db.Uuid
  loanId           String?               @unique @map("loan_id") @db.Uuid
  principalCents   Int                   @map("principal_cents")
  interestType     InterestType          @map("interest_type")
  termPeriods      Int                   @map("term_periods")
  frequency        RepaymentFrequency
  startDate        DateTime              @map("start_date") @db.Date
  purpose          String?
  status           LoanApplicationStatus @default(DRAFT)
  bankAccountHolder String?              @map("bank_account_holder")
  bankName          String?              @map("bank_name")
  bankBranchCode    String?              @map("bank_branch_code")
  bankAccountNumber String?              @map("bank_account_number")
  lenderNotes      String?               @map("lender_notes")
  reviewChecklist  Json?                 @map("review_checklist")
  reviewedByUserId String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?             @map("reviewed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  borrowerUser User         @relation("LoanApplicationBorrower", fields: [borrowerUserId], references: [id])
  borrower     Borrower?    @relation(fields: [borrowerId], references: [id])
  loan         Loan?        @relation(fields: [loanId], references: [id])
  reviewedBy   User?        @relation("LoanApplicationReviewer", fields: [reviewedByUserId], references: [id])

  @@index([orgId, status])
  @@index([borrowerUserId])
  @@index([orgId, borrowerUserId])
  @@map("loan_applications")
}

model Borrower {
  id                 String    @id @default(uuid()) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  platformUserId     String?   @map("platform_user_id") @db.Uuid
  fullName           String    @map("full_name")
  idNumber           String    @map("id_number")
  phone              String
  email              String?
  address            String?
  employer           String?
  monthlyIncomeCents Int?      @map("monthly_income_cents")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  loans        Loan[]
  loanApplications LoanApplication[]

  @@unique([orgId, idNumber])
  @@index([orgId, platformUserId])
  @@index([orgId])
  @@index([orgId, fullName])
  @@map("borrowers")
}

model Loan {
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String             @map("org_id") @db.Uuid
  borrowerId      String             @map("borrower_id") @db.Uuid
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  principalCents  Int                @map("principal_cents")
  interestRate    Decimal            @map("interest_rate") @db.Decimal(8, 4)
  interestType    InterestType       @map("interest_type")
  termPeriods     Int                @map("term_periods")
  frequency       RepaymentFrequency
  startDate       DateTime           @map("start_date") @db.Date
  status             LoanStatus         @default(DRAFT)
  disbursementStatus DisbursementStatus @default(NOT_STARTED) @map("disbursement_status")
  disbursedAt        DateTime?          @map("disbursed_at")
  writeOffReason     String?            @map("write_off_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  organisation       Organisation        @relation(fields: [orgId], references: [id])
  borrower           Borrower            @relation(fields: [borrowerId], references: [id])
  createdBy          User                @relation("LoanCreatedBy", fields: [createdByUserId], references: [id])
  repaymentSchedules RepaymentSchedule[]
  repayments         Repayment[]
  loanApplication    LoanApplication?
  paymentSubmissions PaymentSubmission[]
  stitchDisbursement LoanStitchDisbursement?

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, borrowerId])
  @@map("loans")
}

model RepaymentSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  loanId             String   @map("loan_id") @db.Uuid
  periodNumber       Int      @map("period_number")
  dueDate            DateTime @map("due_date") @db.Date
  principalDueCents  Int      @map("principal_due_cents")
  interestDueCents   Int      @map("interest_due_cents")
  totalDueCents      Int      @map("total_due_cents")
  balanceAfterCents  Int      @map("balance_after_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  loan Loan @relation(fields: [loanId], references: [id])

  @@unique([loanId, periodNumber])
  @@index([loanId])
  @@index([dueDate])
  @@map("repayment_schedules")
}

/// Immutable — insert only, never update or delete.
model Repayment {
  id               String   @id @default(uuid()) @db.Uuid
  loanId           String   @map("loan_id") @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  amountCents      Int      @map("amount_cents")
  paymentDate      DateTime @map("payment_date") @db.Date
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  loan       Loan         @relation(fields: [loanId], references: [id])
  organisation Organisation @relation(fields: [orgId], references: [id])
  recordedBy User         @relation("RepaymentRecordedBy", fields: [recordedByUserId], references: [id])
  paymentSubmission PaymentSubmission?

  @@index([loanId])
  @@index([orgId])
  @@index([orgId, paymentDate])
  @@map("repayments")
}

model PaymentSubmission {
  id                String                  @id @default(uuid()) @db.Uuid
  orgId             String                  @map("org_id") @db.Uuid
  loanId            String                  @map("loan_id") @db.Uuid
  submittedByUserId String                  @map("submitted_by_user_id") @db.Uuid
  amountCents       Int                     @map("amount_cents")
  paymentDate       DateTime                @map("payment_date") @db.Date
  referenceNote     String?                 @map("reference_note")
  provider          PaymentProvider         @default(MANUAL)
  externalReference String?                 @map("external_reference")
  status            PaymentSubmissionStatus @default(AWAITING_PROOF)
  repaymentId       String?                 @unique @map("repayment_id") @db.Uuid
  reviewedByUserId  String?                 @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?               @map("reviewed_at")
  reviewNote        String?                 @map("review_note")
  submittedAt       DateTime?               @map("submitted_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  loan         Loan         @relation(fields: [loanId], references: [id])
  submittedBy  User         @relation("PaymentSubmissionSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedBy   User?        @relation("PaymentSubmissionReviewedBy", fields: [reviewedByUserId], references: [id])
  repayment    Repayment?   @relation(fields: [repaymentId], references: [id])

  @@index([orgId, status])
  @@index([loanId])
  @@index([submittedByUserId])
  @@map("payment_submissions")
}

model Document {
  id               String             @id @default(uuid()) @db.Uuid
  orgId            String             @map("org_id") @db.Uuid
  entityType       DocumentEntityType @map("entity_type")
  entityId         String             @map("entity_id") @db.Uuid
  documentType     String             @map("document_type")
  storagePath      String             @map("storage_path")
  originalFilename String             @map("original_filename")
  uploadedByUserId String             @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, entityType, entityId])
  @@map("documents")
}

/// Immutable — insert only, never update or delete.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String
  title             String
  body              String
  dedupKey          String?   @map("dedup_key")
  readAt            DateTime? @map("read_at")
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, dedupKey])
  @@index([orgId, userId])
  @@index([orgId, userId, readAt])
  @@map("notifications")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  orgId                String             @map("org_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  plan                 OrganisationPlan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime           @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("subscriptions")
}

model Wallet {
  id                    String          @id @default(uuid()) @db.Uuid
  ownerType             WalletOwnerType @map("owner_type")
  ownerOrgId            String?         @unique @map("owner_org_id") @db.Uuid
  ownerUserId           String?         @unique @map("owner_user_id") @db.Uuid
  availableBalanceCents Int             @default(0) @map("available_balance_cents")
  currency              String          @default("ZAR")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  ownerOrg     Organisation?      @relation(fields: [ownerOrgId], references: [id], onDelete: Cascade)
  ownerUser    User?              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bankAccount  WalletBankAccount?
  transactions WalletTransaction[]

  @@index([ownerType])
  @@map("wallets")
}

model WalletBankAccount {
  id            String    @id @default(uuid()) @db.Uuid
  walletId      String    @unique @map("wallet_id") @db.Uuid
  accountHolder String    @map("account_holder")
  bankName      String    @map("bank_name")
  branchCode    String    @map("branch_code")
  accountNumber String    @map("account_number")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_bank_accounts")
}

model WalletTransaction {
  id                  String                  @id @default(uuid()) @db.Uuid
  walletId            String                  @map("wallet_id") @db.Uuid
  orgId               String?                 @map("org_id") @db.Uuid
  type                WalletTransactionType
  status              WalletTransactionStatus
  amountCents         Int                     @map("amount_cents")
  balanceAfterCents   Int?                    @map("balance_after_cents")
  loanId              String?                 @map("loan_id") @db.Uuid
  paymentSubmissionId String?                 @map("payment_submission_id") @db.Uuid
  description         String?
  idempotencyKey      String?                 @unique @map("idempotency_key")
  createdByUserId     String?                 @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([orgId])
  @@index([loanId])
  @@map("wallet_transactions")
}

model UserKycDocument {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  documentType     String   @map("document_type")
  storagePath      String   @map("storage_path")
  originalFilename String   @map("original_filename")
  contentType      String   @map("content_type")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType])
  @@index([userId])
  @@map("user_kyc_documents")
}

model LoanStitchDisbursement {
  id                       String                  @id @default(uuid()) @db.Uuid
  loanId                   String                  @unique @map("loan_id") @db.Uuid
  orgId                    String                  @map("org_id") @db.Uuid
  stitchDisbursementId     String?                 @unique @map("stitch_disbursement_id")
  nonce                    String                  @unique
  externalReference        String                  @unique @map("external_reference")
  amountCents              Int                     @map("amount_cents")
  status                   StitchDisbursementStatus @default(PENDING)
  statusReason             String?                 @map("status_reason")
  beneficiaryName          String                  @map("beneficiary_name")
  beneficiaryAccountNumber String                  @map("beneficiary_account_number")
  beneficiaryBankId        String                  @map("beneficiary_bank_id")
  beneficiaryReference     String                  @map("beneficiary_reference")
  disbursementType         String                  @default("default") @map("disbursement_type")
  lastWebhookAt            DateTime?               @map("last_webhook_at")
  createdByUserId          String                  @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  loan         Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@map("loan_stitch_disbursements")
}

/// LinkPay authorization for lender org — pull funds per loan (phase 2).
model OrganisationStitchLinkPay {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @unique @map("org_id") @db.Uuid
  refreshToken    String    @map("refresh_token")
  accessToken     String?   @map("access_token")
  accessExpiresAt DateTime? @map("access_expires_at")
  status          String    @default("ACTIVE")
  linkedAt        DateTime  @default(now()) @map("linked_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

