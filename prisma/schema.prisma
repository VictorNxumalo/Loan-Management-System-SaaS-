// LMS — Loan Management System
// Multi-tenant schema with org_id on all tenant-scoped tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  LOAN_OFFICER
  VIEWER
}

enum AccountType {
  LENDER
  BORROWER
}

enum BorrowerLinkSource {
  INVITE
  PUBLIC
}

enum OrganisationPlan {
  STARTER
  PRO
  BUSINESS
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  READ_ONLY
}

enum InterestType {
  FLAT
  REDUCING
}

enum LoanStatus {
  DRAFT
  ACTIVE
  IN_ARREARS
  COMPLETED
  WRITTEN_OFF
}

enum RepaymentFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum LoanApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum DocumentEntityType {
  BORROWER
  LOAN
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Organisation {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  plan               OrganisationPlan @default(STARTER)
  planStatus         PlanStatus       @default(TRIAL) @map("plan_status")
  settings           Json             @default("{}")
  stripeCustomerId   String?          @unique @map("stripe_customer_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  users         User[]
  borrowers     Borrower[]
  loans         Loan[]
  repayments    Repayment[]
  documents     Document[]
  auditLogs     AuditLog[]
  notifications Notification[]
  subscriptions Subscription[]
  lenderInvites     LenderInvite[]
  borrowerLinks     BorrowerLenderLink[]
  loanApplications  LoanApplication[]

  @@map("organisations")
}

model User {
  id                    String      @id @default(uuid()) @db.Uuid
  accountType           AccountType @default(LENDER) @map("account_type")
  orgId                 String?     @map("org_id") @db.Uuid
  email                 String      @unique
  name                  String
  role                  UserRole?   @default(LOAN_OFFICER)
  passwordHash          String?     @map("password_hash")
  googleId              String?     @unique @map("google_id")
  emailVerifiedAt       DateTime?   @map("email_verified_at")
  onboardingCompletedAt DateTime?   @map("onboarding_completed_at")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deletedAt             DateTime?   @map("deleted_at")

  organisation            Organisation?            @relation(fields: [orgId], references: [id])
  borrowerAccount         BorrowerAccount?
  borrowerLinks           BorrowerLenderLink[]
  loanApplications        LoanApplication[]       @relation("LoanApplicationBorrower")
  loanApplicationsReviewed LoanApplication[]        @relation("LoanApplicationReviewer")
  loansCreated            Loan[]                   @relation("LoanCreatedBy")
  repaymentsRecorded      Repayment[]              @relation("RepaymentRecordedBy")
  documentsUploaded       Document[]               @relation("DocumentUploadedBy")
  auditLogs               AuditLog[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([orgId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model BorrowerAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  phone     String
  idNumber  String?  @map("id_number")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("borrower_accounts")
}

model BorrowerLenderLink {
  id             String            @id @default(uuid()) @db.Uuid
  borrowerUserId String            @map("borrower_user_id") @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  source         BorrowerLinkSource @default(INVITE)
  createdAt      DateTime          @default(now()) @map("created_at")

  borrowerUser User         @relation(fields: [borrowerUserId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([borrowerUserId, orgId])
  @@index([borrowerUserId])
  @@index([orgId])
  @@map("borrower_lender_links")
}

model LenderInvite {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@map("lender_invites")
}

model LoanApplication {
  id               String                @id @default(uuid()) @db.Uuid
  orgId            String                @map("org_id") @db.Uuid
  borrowerUserId   String                @map("borrower_user_id") @db.Uuid
  borrowerId       String?               @map("borrower_id") @db.Uuid
  loanId           String?               @unique @map("loan_id") @db.Uuid
  principalCents   Int                   @map("principal_cents")
  interestType     InterestType          @map("interest_type")
  termPeriods      Int                   @map("term_periods")
  frequency        RepaymentFrequency
  startDate        DateTime              @map("start_date") @db.Date
  purpose          String?
  status           LoanApplicationStatus @default(SUBMITTED)
  lenderNotes      String?               @map("lender_notes")
  reviewedByUserId String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?             @map("reviewed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  borrowerUser User         @relation("LoanApplicationBorrower", fields: [borrowerUserId], references: [id])
  borrower     Borrower?    @relation(fields: [borrowerId], references: [id])
  loan         Loan?        @relation(fields: [loanId], references: [id])
  reviewedBy   User?        @relation("LoanApplicationReviewer", fields: [reviewedByUserId], references: [id])

  @@index([orgId, status])
  @@index([borrowerUserId])
  @@index([orgId, borrowerUserId])
  @@map("loan_applications")
}

model Borrower {
  id                 String    @id @default(uuid()) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  platformUserId     String?   @map("platform_user_id") @db.Uuid
  fullName           String    @map("full_name")
  idNumber           String    @map("id_number")
  phone              String
  email              String?
  address            String?
  employer           String?
  monthlyIncomeCents Int?      @map("monthly_income_cents")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  loans        Loan[]
  loanApplications LoanApplication[]

  @@unique([orgId, idNumber])
  @@index([orgId, platformUserId])
  @@index([orgId])
  @@index([orgId, fullName])
  @@map("borrowers")
}

model Loan {
  id              String             @id @default(uuid()) @db.Uuid
  orgId           String             @map("org_id") @db.Uuid
  borrowerId      String             @map("borrower_id") @db.Uuid
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  principalCents  Int                @map("principal_cents")
  interestRate    Decimal            @map("interest_rate") @db.Decimal(8, 4)
  interestType    InterestType       @map("interest_type")
  termPeriods     Int                @map("term_periods")
  frequency       RepaymentFrequency
  startDate       DateTime           @map("start_date") @db.Date
  status          LoanStatus         @default(DRAFT)
  writeOffReason  String?            @map("write_off_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  organisation       Organisation        @relation(fields: [orgId], references: [id])
  borrower           Borrower            @relation(fields: [borrowerId], references: [id])
  createdBy          User                @relation("LoanCreatedBy", fields: [createdByUserId], references: [id])
  repaymentSchedules RepaymentSchedule[]
  repayments         Repayment[]
  loanApplication    LoanApplication?

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, borrowerId])
  @@map("loans")
}

model RepaymentSchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  loanId             String   @map("loan_id") @db.Uuid
  periodNumber       Int      @map("period_number")
  dueDate            DateTime @map("due_date") @db.Date
  principalDueCents  Int      @map("principal_due_cents")
  interestDueCents   Int      @map("interest_due_cents")
  totalDueCents      Int      @map("total_due_cents")
  balanceAfterCents  Int      @map("balance_after_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  loan Loan @relation(fields: [loanId], references: [id])

  @@unique([loanId, periodNumber])
  @@index([loanId])
  @@index([dueDate])
  @@map("repayment_schedules")
}

/// Immutable — insert only, never update or delete.
model Repayment {
  id               String   @id @default(uuid()) @db.Uuid
  loanId           String   @map("loan_id") @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  amountCents      Int      @map("amount_cents")
  paymentDate      DateTime @map("payment_date") @db.Date
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  loan       Loan         @relation(fields: [loanId], references: [id])
  organisation Organisation @relation(fields: [orgId], references: [id])
  recordedBy User         @relation("RepaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([loanId])
  @@index([orgId])
  @@index([orgId, paymentDate])
  @@map("repayments")
}

model Document {
  id               String             @id @default(uuid()) @db.Uuid
  orgId            String             @map("org_id") @db.Uuid
  entityType       DocumentEntityType @map("entity_type")
  entityId         String             @map("entity_id") @db.Uuid
  documentType     String             @map("document_type")
  storagePath      String             @map("storage_path")
  originalFilename String             @map("original_filename")
  uploadedByUserId String             @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([orgId])
  @@index([orgId, entityType, entityId])
  @@map("documents")
}

/// Immutable — insert only, never update or delete.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String
  title             String
  body              String
  dedupKey          String?   @map("dedup_key")
  readAt            DateTime? @map("read_at")
  relatedEntityType String?   @map("related_entity_type")
  relatedEntityId   String?   @map("related_entity_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, dedupKey])
  @@index([orgId, userId])
  @@index([orgId, userId, readAt])
  @@map("notifications")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  orgId                String             @map("org_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  plan                 OrganisationPlan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime           @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("subscriptions")
}
