# =============================================================================
# LMS — Staging environment (hosted testing, disposable data)
# Copy values into your hosting provider's env UI (Vercel + Render + Supabase).
# NODE_ENV=production on staging; use fake borrowers and small amounts only.
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=sandbox

# ─── Supabase Postgres ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Redis (Upstash or Render Redis) ─────────────────────────────────────────
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# ─── JWT (generate fresh secrets — min 32 chars each) ────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Email — skip verification on staging ────────────────────────────────────
SKIP_EMAIL_VERIFICATION=true
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lms-documents

# ─── Stripe — test mode only on staging ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
TRIAL_DAYS=14

# ─── API (Render sets PORT automatically; API_PORT is fallback) ──────────────
API_PORT=3001
# Must match your SANDBOX Vercel URL (not production) — no trailing slash
NEXTAUTH_URL=https://your-sandbox-app.vercel.app
# Allow Vercel preview deploy URLs (*.vercel.app) — sandbox only
STAGING_ALLOW_VERCEL_CORS=true

# ─── Web (Vercel sandbox project — Production Branch = staging) ──────────────
NEXT_PUBLIC_API_URL=https://lms-sandbox-api.onrender.com/v1
# Server-side NextAuth login (same URL — set for Production + Preview on sandbox project)
API_URL=https://lms-sandbox-api.onrender.com/v1
NEXTAUTH_SECRET=
# Legal pages — set before production go-live
# NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Your Company (Pty) Ltd
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@yourdomain.com
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Crons (optional on staging) ─────────────────────────────────────────────
CRON_OVERDUE_ENABLED=true
CRON_REMINDER_ENABLED=true
