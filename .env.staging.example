# =============================================================================
# LMS — Staging environment (hosted testing, disposable data)
# Copy values into your hosting provider's env UI (Vercel + Render + Supabase).
# NODE_ENV=production on staging; use fake borrowers and small amounts only.
# =============================================================================

NODE_ENV=production

# ─── Supabase Postgres ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Redis (Upstash or Render Redis) ─────────────────────────────────────────
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# ─── JWT (generate fresh secrets — min 32 chars each) ────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Email — skip verification on staging ────────────────────────────────────
SKIP_EMAIL_VERIFICATION=true
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lms-documents

# ─── Stripe — test mode only on staging ──────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
TRIAL_DAYS=14

# ─── API (Render sets PORT automatically; API_PORT is fallback) ──────────────
API_PORT=3001
# Must exactly match the Vercel web URL (CORS + auth cookies)
NEXTAUTH_URL=https://lms-staging.vercel.app

# ─── Web (Vercel) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://lms-staging-api.onrender.com/v1
NEXTAUTH_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Crons (optional on staging) ─────────────────────────────────────────────
CRON_OVERDUE_ENABLED=true
CRON_REMINDER_ENABLED=true
