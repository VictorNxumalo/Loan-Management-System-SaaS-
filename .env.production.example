# =============================================================================
# LMS — Production (real users)
# Copy into Vercel (production project) + Render (production API) dashboards.
# Use a dedicated Supabase project, live Stripe (if billing), SendGrid, verified domain.
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# ─── Supabase — dedicated PRODUCTION project ─────────────────────────────────
DATABASE_URL=postgresql://postgres.[PROD-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROD-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[PROD-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lms-documents

# ─── Redis (production instance) ─────────────────────────────────────────────
REDIS_URL=

# ─── JWT — unique to production ──────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
SKIP_EMAIL_VERIFICATION=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ─── Stripe — live mode (when billing is enabled) ────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Production web URL (custom domain recommended) ──────────────────────────
NEXTAUTH_URL=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/v1
API_URL=https://api.yourdomain.com/v1
NEXTAUTH_SECRET=

# Do NOT set on production — locks CORS to NEXTAUTH_URL only
# STAGING_ALLOW_VERCEL_CORS=false

# ─── Legal ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Your Company (Pty) Ltd
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@yourdomain.com

TRIAL_DAYS=14
CRON_OVERDUE_ENABLED=true
CRON_REMINDER_ENABLED=true
