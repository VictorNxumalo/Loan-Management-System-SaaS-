{
  "name": "@lms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "predev": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true});require('fs').unlinkSync('tsconfig.build.tsbuildinfo')}catch(e){}\"",
    "dev": "nest build && node --watch dist/main.js",
    "start": "nest start",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lms/types": "workspace:*",
    "@lms/utils": "workspace:*",
    "@nestjs/common": "^11.1.1",
    "@nestjs/core": "^11.1.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.8.2",
    "@supabase/supabase-js": "^2.108.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.78.0",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
