# =============================================================================
# LMS — Loan Management System
# Copy this file to .env and fill in values for local development.
# =============================================================================

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Get both strings from Supabase Dashboard → Project → Connect → ORM / Prisma
#
# DATABASE_URL — Supavisor Transaction pooler (port 6543). Used for Prisma migrations tooling.
# The API runs RLS-scoped interactive transactions via DIRECT_URL (session pooler, port 5432).
# Append ?pgbouncer=true (required for Prisma with transaction mode).
# Format:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-af-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL — Supavisor Session pooler (port 5432) for Prisma migrations.
# Format:
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-af-south-1.pooler.supabase.com:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection string for BullMQ job queue
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication (API) ─────────────────────────────────────────────────
# Secret for signing JWT access tokens (min 32 chars, use a cryptographically random value)
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# Separate secret for refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars

# ─── Email (Brevo) — free tier ~300 emails/day ───────────────────────────────
# Skip email verification on registration (default true — accounts can sign in immediately)
SKIP_EMAIL_VERIFICATION=true
# API key: https://app.brevo.com/settings/keys/api
# Sender must be verified: https://app.brevo.com/senders
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=LMS

# ─── Google OAuth (Optional) ──────────────────────────────────────────────────
# If unset, Google sign-in button is hidden on the login page
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Public client ID for showing the Google button (same value as GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Stripe Billing ───────────────────────────────────────────────────────────
# Stripe secret key (sk_test_... for development, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret from the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe price IDs — create Products + recurring Prices in Stripe Dashboard
STRIPE_PRICE_STARTER=price_your_starter_price_id
STRIPE_PRICE_PRO=price_your_pro_price_id
STRIPE_PRICE_BUSINESS=price_your_business_price_id

# Free trial length for new lender organisations (days)
TRIAL_DAYS=14

# Comma-separated emails allowed to review lender compliance (LMS operators)
# PLATFORM_ADMIN_EMAILS=you@yourdomain.com

# ─── Stitch (SA disbursements + LinkPay) ────────────────────────────────────
# Test credentials from https://stitch.money — keep false until float is funded.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
STITCH_DISBURSEMENTS_ENABLED=false
# STITCH_API_BASE=https://api.stitch.money/v2
# STITCH_TOKEN_URL=https://secure.stitch.money/connect/token

# SA repo rate (% p.a.) for NCA maximum interest cap: (repo × 2.2) + 20
NCR_REPO_RATE_PERCENT=8.25

# ─── Supabase Storage (Documents) ─────────────────────────────────────────────
# Project URL from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — API only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Private bucket for org-scoped lender documents
SUPABASE_STORAGE_BUCKET=lms-documents
# Signed upload/download URL expiry (seconds) — default 900 (15 minutes)
DOCUMENT_URL_EXPIRY_SECONDS=900

# ─── SMS (Optional) ───────────────────────────────────────────────────────────
# Twilio credentials — optional; SMS notifications enabled when configured
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Africa's Talking — preferred SMS provider for SA market (optional)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_africastalking_username

# ─── Notification crons ───────────────────────────────────────────────────────
# Daily scan for repayments due in 3 days (borrower email + in-app + optional SMS)
CRON_REMINDER_ENABLED=true
CRON_REMINDER_SCHEDULE=0 7 * * *

# ─── Frontend (Next.js / NextAuth) ───────────────────────────────────────────
# Base URL of the NestJS API (include /v1 path prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Stripe publishable key for Stripe.js on the frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Secret for NextAuth.js session encryption (min 32 chars, random)
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret-32-chars

# Canonical URL of the Next.js app (must match the URL in your browser)
# Use http://localhost:3000 for desktop-only dev.
# For mobile testing on the same Wi‑Fi, run: pnpm dev:mobile
# (sets NEXTAUTH_URL and NEXT_PUBLIC_API_URL to your LAN IP automatically)
NEXTAUTH_URL=http://localhost:3000

# ─── Legal pages (public Terms & Privacy) ─────────────────────────────────────
# Operator name shown in /legal/terms and /legal/privacy
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Your Company (Pty) Ltd
# Contact for legal/privacy enquiries (mailto link on legal pages)
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@yourdomain.com

# ─── API Server ───────────────────────────────────────────────────────────────
# Port for the NestJS API (default 3001)
API_PORT=3001

# Node environment
NODE_ENV=development

# ─── Overdue detection cron ───────────────────────────────────────────────────
# Daily sweep that marks loans IN_ARREARS or COMPLETED based on schedule/repayments
CRON_OVERDUE_ENABLED=true
CRON_OVERDUE_SCHEDULE=0 6 * * *
