# =============================================================================
# LMS — Loan Management System
# Copy this file to .env and fill in values for local development.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (matches docker-compose defaults)
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5432/lms

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection string for BullMQ job queue
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication (API) ─────────────────────────────────────────────────
# Secret for signing JWT access tokens (min 32 chars, use a cryptographically random value)
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# Separate secret for refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars

# ─── Stripe Billing ───────────────────────────────────────────────────────────
# Stripe secret key (sk_test_... for development, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret from the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
# SendGrid API key for transactional email (verification, reminders, alerts)
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ─── AWS S3 Document Storage ──────────────────────────────────────────────────
# AWS credentials for generating pre-signed S3 upload/download URLs
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3 bucket name for borrower/loan document uploads
AWS_S3_BUCKET=lms-documents-dev

# AWS region (e.g. af-south-1 for South Africa, us-east-1 for US)
AWS_REGION=af-south-1

# ─── SMS (Optional) ───────────────────────────────────────────────────────────
# Twilio credentials — optional; SMS notifications enabled when configured
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ─── Frontend (Next.js / NextAuth) ───────────────────────────────────────────
# Base URL of the NestJS API (include /v1 path prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Stripe publishable key for Stripe.js on the frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Secret for NextAuth.js session encryption (min 32 chars, random)
NEXTAUTH_SECRET=change-me-to-a-random-nextauth-secret-32-chars

# Canonical URL of the Next.js app
NEXTAUTH_URL=http://localhost:3000

# ─── API Server ───────────────────────────────────────────────────────────────
# Port for the NestJS API (default 3001)
API_PORT=3001
